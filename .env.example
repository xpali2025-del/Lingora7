# ---- Required ----
SITE_URL=https://lingora.world
DATABASE_URL=postgres://lingora:change-me@localhost:5432/lingora
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts emails, redeem links and provider secrets. LOSING IT = LOSING THE DATA. Back it up separately from the database.
MASTER_ENCRYPTION_KEY=

# ---- Email (transactional) ----
EMAIL_PROVIDER=resend            # resend | postmark | log (log = print only, for staging)
EMAIL_API_KEY=
EMAIL_FROM=support@lingora.world

# ---- Worker ----
WORKER_POLL_SECONDS=20
ALERT_WEBHOOK_URL=               # optional: POST {"text": "..."} (Telegram/WhatsApp/Slack bridge) for owner alerts

# ---- Bot protection (optional but recommended; Cloudflare Turnstile) ----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Local development only ----
# DB_POOL_MAX=1  DB_IDLE_MS=100   (with `npm run dev:db`)
# INSECURE_COOKIES=1              (admin cookie without the Secure flag on http://localhost)

# ---- Proxy / client IP (rate limits, per-IP caps, admin lockouts depend on this being right) ----
# If your edge sets a dedicated header (Cloudflare: cf-connecting-ip) name it here; otherwise the
# entry added by the Nth trusted proxy from the RIGHT of X-Forwarded-For is used (TRUSTED_PROXY_HOPS, default 1).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
SUPPORT_EMAIL=support@lingora.world
# SITE_URL is also read at BUILD time (canonicals, hreflang, sitemap): set it before `npm run web:build`
# (Docker: build arg SITE_URL).

# ---- Optional: IndexNow (Bing/Yandex) after deploy ----
INDEXNOW_KEY=

# ---- Free hosting (no VPS): Supabase + Render + GitHub Actions. See README "النشر المجاني" ----
# Supabase: Project > Connect > "Transaction pooler" connection string (port 6543) goes in DATABASE_URL.
# DB_SSL=require verifies the certificate: paste Supabase's CA certificate (Project Settings > Database > SSL) into DB_SSL_CA
# (newlines may be written as \n). DB_SSL=no-verify encrypts without verifying (weaker; only if you cannot supply the CA).
DB_SSL=require
DB_SSL_CA=
# Shared secret between the server and the scheduler (GitHub Actions secret CRON_SECRET). Long and random.
CRON_SECRET=
# Sign in with Google (admin and customers). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google addresses that become OWNER the first time they sign in to /admin/ (no shell needed).
OWNER_EMAILS=
# On-chain payment detection (no API key, no static IP). Two independent public nodes: the second one double-checks every payment.
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BSC_VERIFY_RPC_URL=https://bsc-dataseed.binance.org
