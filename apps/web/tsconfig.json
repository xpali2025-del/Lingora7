{ "compilerOptions": { "target": "ES2022", "lib": ["dom","esnext"], "jsx": "preserve", "module": "esnext",
  "moduleResolution": "bundler", "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
  "resolveJsonModule": true, "isolatedModules": true, "incremental": true, "allowJs": true,
  "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] } },
  "include": ["shared.d.ts","next-env.d.ts","**/*.ts","**/*.tsx",".next/types/**/*.ts"], "exclude": ["node_modules"] }
